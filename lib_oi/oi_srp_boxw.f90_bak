!*
SUBROUTINE oi_srp_boxw(lpart,mjd,sod,cprn,csvn,blk,PAN,mass,lambda,npar,pname,xics,xsat,xsun,acc,cmat)
!!
!*
USE const
USE satellite
IMPLICIT NONE

!*
! The arguments
!!-------------------------
TYPE(SATEPAN) :: PAN
LOGICAL(LG) :: lpart
INTEGER(IT) :: npar,mjd
CHARACTER(LEN=*) :: cprn,csvn,blk,pname(1:*)
REAL(RL) :: sod,mass,xics(1:*),acc(1:*)
REAL(RL) :: lambda,cmat(1:*),xsat(1:*),xsun(1:*)

  !*
  ! The local variables
  !!-----------------------------

  INTEGER(IT) :: i,j,k
  REAL(RL) :: factor,cosf,det,beta,phi
  REAL(RL) :: d_unit(3),y_unit(3),b_unit(3)
  REAL(RL) :: x_unit(3),s_unit(3),z_unit(3)
  REAL(RL) :: sp_unit(3),fac,yb_unit(3)
  REAL(RL) :: u,f(3),cost(7),d0_const,bb_unit(3)

  INTEGER(IT), PARAMETER :: MAXPARLOC=18
  INTEGER(IT) :: ltog(MAXPARLOC)
  CHARACTER(LEN_ORBPAR) :: lpname(MAXPARLOC)
  REAL(RL) :: param(MAXPARLOC)
  DATA lpname &
   / 'Ksp_BOXW  ','Ksb_BOXW  ','Ky_BOXW   ','K+xad_BOXW', &
     'K-xad_BOXW','K+yad_BOXW','K-yad_BOXW','K+zad_BOXW', &
     'K-zad_BOXW','K+xr_BOXW ','K-xr_BOXW ','K+yr_BOXW ', &
     'K-yr_BOXW ','K+zr_BOXW ','K-zr_BOXW ','Kbc1_BERN ', &
     'Kbs1_BERN ','SR_scale  '/


  REAL(RL) :: f_dyb(3),f_xyz(3),f_acr(3), fb(3)
  REAL(RL) :: a_unit(3),c_unit(3),r_unit(3)

  !*
  ! The function called
  !!-----------------------------
  REAL(RL) :: dot
  INTEGER(IT) :: pointer_string

  !*
  ! Start the exectuable code
  !!-----------------------------

  DO i=1, MAXPARLOC
    ltog(i)=pointer_string(npar,pname,lpname(i))
  END DO

  DO i=1, MAXPARLOC
    param(i)=0.d0
    IF (i .EQ. MAXPARLOC) param(i)=1.d0
    IF (ltog(i) .NE. 0) param(i)=param(i)+xics(ltog(i))
  END DO

  SELECT CASE(TRIM(blk))
    CASE('BLOCK I')
      d0_const=4.54d-5
    CASE('BLOCK II')
      d0_const=8.695d-5
    CASE('BLOCK IIA')
      d0_const=8.958d-5
    CASE('BLOCK IIR-A')
      d0_const=11.17d-5
    CASE('BLOCK IIR-B')
      d0_const=11.17d-5
    CASE('BLOCK IIR-M')
      d0_const=10.88d-5
    CASE('BLOCK IIF')
      d0_const=16.70d-5
    CASE('BLOCK III')
      d0_const=mass
    CASE('GLONASS')
      d0_const=mass
    CASE('GLONASS-M')
      d0_const=21.03d-5
    CASE('GLONASS-K1')
      d0_const=7.95d-5
    CASE('GALILEO-0A')
      d0_const=mass
    CASE('GALILEO-0B')
      d0_const=mass
    CASE('GALILEO-1')
      d0_const=12.06d-5
    CASE('GALILEO-2')
      d0_const=12.22d-5
    CASE('BEIDOU-2G')
      d0_const=17.76d-5
    CASE('BEIDOU-2I')
      d0_const=17.18d-5
    CASE('BEIDOU-2M')
      d0_const=14.27d-5
    CASE('BEIDOU-3IS-SECM')
      d0_const=mass
    CASE('BEIDOU-3IS-CAST')
      d0_const=27.18d-5
    CASE('BEIDOU-3MS-SECM')
      d0_const=mass
    CASE('BEIDOU-3MS-CAST')
      d0_const=14.32d-5
    CASE('BEIDOU-3G-SECM')
      d0_const=mass
    CASE('BEIDOU-3G-CAST')
      d0_const=mass
    CASE('BEIDOU-3I-SECM')
      d0_const=mass
    CASE('BEIDOU-3I-CAST')
      d0_const=mass
    CASE('BEIDOU-3M-SECM')
      d0_const=8.59d-5
    CASE('BEIDOU-3M-CAST')
      d0_const=13.79d-5
    CASE('QZSS')
      d0_const=16.68d-5
    CASE('QZSS-2I')
      d0_const=24.53d-5
    CASE('QZSS-2G')
      d0_const=25.04d-5
    CASE('IRNSS-1IGSO')
      d0_const=11.89d-5
    CASE('IRNSS-1GEO')
      d0_const=11.51d-5
    CASE DEFAULT
      d0_const=1367.d0/VEL_LIGHT
  END SELECT
  d0_const=d0_const/mass

  ! Vector satellite to sun
  DO i=1, 3
    d_unit(i)=xsun(i)-xsat(i)
  END DO
  CALL unit_vector(3,d_unit,d_unit,det)

  factor=(149597870.691d0/det)**2
  fac=factor

  DO i=1 ,3
    z_unit(i)=-xsat(i)
  END DO
  CALL unit_vector(3,z_unit,z_unit,det)

  CALL cross(z_unit,d_unit,y_unit)
  CALL unit_vector(3,y_unit,y_unit,det)

  CALL cross(d_unit,y_unit,b_unit)
  CALL unit_vector(3,b_unit,b_unit,det)

  CALL cross(y_unit,z_unit,x_unit)
  CALL unit_vector(3,x_unit,x_unit,det)

  ! GEO satellite, change the difinition of Yb
  IF (INDEX(blk,'BEIDOU-2G') .NE. 0) THEN
    yb_unit=y_unit
    bb_unit=b_unit
  END IF

  CALL rot_scfix2j2000(mjd,sod,cprn,csvn,blk,xsat,xsun,x_unit,y_unit,z_unit)

  CALL cross(d_unit,y_unit,b_unit)
  CALL unit_vector(3,b_unit,b_unit,det)

  CALL cross(y_unit,b_unit,sp_unit)
  CALL unit_vector(3,sp_unit,sp_unit,det)

  !! IGSO and MEO
  IF (INDEX(blk,'BEIDOU-2G') .EQ. 0) THEN
    yb_unit=y_unit
    bb_unit=b_unit
  ELSE
    ! For GEO satellite in order to keep consistent with Chen Guo's analysis
    sp_unit=d_unit
  END IF

  CALL betau(xsat,xsun,beta,u)

  !phi=ATAN2(-DTAN(beta),DSIN(u))
  phi=DACOS(dot(3,z_unit,d_unit))
  u=u-PI

  factor=-lambda*factor*1367.d0/VEL_LIGHT/mass*param(MAXPARLOC)*1.d-3
  ! take care the code
  !sp_unit=d_unit

  f=0.d0
  DO i=1, PAN.npan
    ! only for +X, -X, +Y, -Y, +Z, -Z, and solar panels
    SELECT CASE(i)
      CASE(1)
        PAN.normj(1:3,1) = x_unit(1:3)
      CASE(2)
        PAN.normj(1:3,2) =-x_unit(1:3)
      CASE(3)
        PAN.normj(1:3,3) = y_unit(1:3)
      CASE(4)
        PAN.normj(1:3,4) =-y_unit(1:3)
      CASE(5)
        PAN.normj(1:3,5) = z_unit(1:3)
      CASE(6)
        PAN.normj(1:3,6) =-z_unit(1:3)
      CASE(7)
        PAN.normj(1:3,7) = sp_unit(1:3)
    END SELECT
  
    cost(i)=dot(3,d_unit,PAN.normj(1:3,i))
    IF (DABS(cost(i)) .LT. 1.D-10) cost(i)=0.d0
    IF (cost(i) .GT. 1.D0-1.D-10) cost(i)=1.d0
    IF (cost(i) .LE. 0.d0) CYCLE
    
    DO j=1, 3
      ! +X
      IF (i .EQ. 1) THEN
        !! Add the Thermal Re-Radiation forces
        f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
             ((PAN.alpha(i)+PAN.delta(i)+param(4))*(d_unit(j)+2.d0*PAN.normj(j,i)/3.d0)+ &
             2.d0*(PAN.rho(i)+param(10))*cost(i)*PAN.normj(j,i))
        !! Only Solar Radiation Pressure forces
        !f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
        !     (d_unit(j)+2.d0/3.d0*(PAN.delta(i)+param(4))*PAN.normj(j,i)+(2*cost(i)*PAN.normj(j,i)-d_unit(j))*(PAN.rho(i)+param(10)))
      ! -X
      ELSE IF (i .EQ. 2) THEN
        !! Add the Thermal Re-Radiation forces
        f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
             ((PAN.alpha(i)+PAN.delta(i)+param(5))*(d_unit(j)+2.d0*PAN.normj(j,i)/3.d0)+ &
             2.d0*(PAN.rho(i)+param(11))*cost(i)*PAN.normj(j,i))
        !f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
        !     (d_unit(j)+2.d0/3.d0*(PAN.delta(i)+param(5))*PAN.normj(j,i)+(2*cost(i)*PAN.normj(j,i)-d_unit(j))*(PAN.rho(i)+param(11)))
      ! +Y
      ELSE IF (i .EQ. 3) THEN
        !! Add the Thermal Re-Radiation forces
        f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
             ((PAN.alpha(i)+PAN.delta(i)+param(6))*(d_unit(j)+2.d0*PAN.normj(j,i)/3.d0)+ &
            2.d0*(PAN.rho(i)+param(12))*cost(i)*PAN.normj(j,i))
        !f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
        !     (d_unit(j)+2.d0/3.d0*(PAN.delta(i)+param(6))*PAN.normj(j,i)+(2*cost(i)*PAN.normj(j,i)-d_unit(j))*(PAN.rho(i)+param(12)))
      ! -Y
      ELSE IF (i .EQ. 4) THEN
        !! Add the Thermal Re-Radiation forces
        f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
             ((PAN.alpha(i)+PAN.delta(i)+param(7))*(d_unit(j)+2.d0*PAN.normj(j,i)/3.d0)+ &
             2.d0*(PAN.rho(i)+param(13))*cost(i)*PAN.normj(j,i))
        !f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
        !     (d_unit(j)+2.d0/3.d0*(PAN.delta(i)+param(7))*PAN.normj(j,i)+(2*cost(i)*PAN.normj(j,i)-d_unit(j))*(PAN.rho(i)+param(13)))
      ! +Z
      ELSE IF (i .EQ. 5) THEN
        !! Add the Thermal Re-Radiation forces
        f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
             ((PAN.alpha(i)+PAN.delta(i)+param(8))*(d_unit(j)+2.d0*PAN.normj(j,i)/3.d0)+ &
             2.d0*(PAN.rho(i)+param(14))*cost(i)*PAN.normj(j,i))
        !f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
        !     (d_unit(j)+2.d0/3.d0*(PAN.delta(i)+param(8))*PAN.normj(j,i)+(2*cost(i)*PAN.normj(j,i)-d_unit(j))*(PAN.rho(i)+param(14)))
      ! -Z
      ELSE IF (i .EQ. 6) THEN
        !! Add the Thermal Re-Radiation forces
        f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
             ((PAN.alpha(i)+PAN.delta(i)+param(9))*(d_unit(j)+2.d0*PAN.normj(j,i)/3.d0)+ &
             2.d0*(PAN.rho(i)+param(15))*cost(i)*PAN.normj(j,i))
        !f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
        !     (d_unit(j)+2.d0/3.d0*(PAN.delta(i)+param(9))*PAN.normj(j,i)+(2*cost(i)*PAN.normj(j,i)-d_unit(j))*(PAN.rho(i)+param(15)))
      ! solar panles
      ELSE IF (i .EQ. 7) THEN
        f(j)=f(j)+factor*PAN.area(i)*cost(i)* &
               ((1.d0+PAN.rho(i)+2.d0*PAN.delta(i)/3.d0+param(1))*d_unit(j)+2*PAN.rho(i)*(cost(i)*PAN.normj(j,i)-d_unit(j))+ &
               2.d0*PAN.delta(i)/3.d0*(PAN.normj(j,i)-d_unit(j)))
        !IF (PI-phi .NE. 0.d0) THEN
        !  f(j)=f(j)+factor*PAN.area(i)*2*(PAN.delta(i)/3.d0+PAN.rho(i))*SIGN(1.d0,-DSIN(u)/DSIN(PI-phi))*bb_unit(j)*param(2)
        !END IF
        IF (phi .NE. 0.d0) THEN
          f(j)=f(j)+factor*PAN.area(i)*2*(PAN.delta(i)/3.d0+PAN.rho(i))*SIGN(1.d0,-DCOS(beta)*DSIN(u)/DSIN(phi))*bb_unit(j)*param(2)
        END IF
      END IF
    END DO
  END DO

  DO i=1, 3
    acc(i)=acc(i)+f(i)+ & !+fac*param(3)*y_unit(i)*1.d-12
    fac*1.d-3*d0_const*(param(3)*yb_unit(i)+(param(16)*DSIN(u)+param(17)*DCOS(u))*bb_unit(i))
    fb(i)=f(i)+fac*1.d-3*d0_const*(param(3)*yb_unit(i)+(param(16)*DSIN(u)+param(17)*DCOS(u))*bb_unit(i))
  END DO
   

  IF (lpart .EQ. .FALSE.) RETURN

  DO i=1, MAXPARLOC

    IF (ltog(i) .EQ. 0) CYCLE
    j=(ltog(i)-6-1)*3

    DO k=1, 3

      SELECT CASE(i)
        ! solar panels
        CASE(1)
          IF (cost(7) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(7)*cost(7)*d_unit(k)
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! solar panel rotation lag
        CASE(2)
          !IF (PI-phi .NE. 0.d0) THEN
          !  cmat(j+k)=factor*PAN.area(7)*2*(PAN.delta(7)/3.d0+PAN.rho(7))*SIGN(1.d0,-DSIN(u)/DSIN(PI-phi))*bb_unit(k)
          IF (phi .NE. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(7)*2*(PAN.delta(7)/3.d0+PAN.rho(7))*SIGN(1.d0,-DCOS(beta)*DSIN(u)/DSIN(phi))*bb_unit(k)
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! Y bias
        CASE(3)
          cmat(j+k)=fac*1.d-3*d0_const*yb_unit(k)
        ! absorption plus diffusion of +X
        CASE(4)
          IF (cost(1) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(1)*cost(1)*(d_unit(k)+2.d0*x_unit(k)/3.d0)
            !cmat(j+k)=factor*PAN.area(1)*cost(1)*( 2.d0*x_unit(k)/3.d0)
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! absorption plus diffusion of -X
        CASE(5)
          IF (cost(2) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(2)*cost(2)*(d_unit(k)-2.d0*x_unit(k)/3.d0)
            !cmat(j+k)=factor*PAN.area(2)*cost(2)*(-2.d0*x_unit(k)/3.d0)
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! absorption plus diffusion of +Y
        CASE(6)
          IF (cost(3) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(3)*cost(3)*(d_unit(k)+2.d0*y_unit(k)/3.d0)
            !cmat(j+k)=factor*PAN.area(3)*cost(3)*( 2.d0*y_unit(k)/3.d0)
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! absorption plus diffusion of -Y
        CASE(7)
          IF (cost(4) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(4)*cost(4)*(d_unit(k)-2.d0*y_unit(k)/3.d0)
            !cmat(j+k)=factor*PAN.area(4)*cost(4)*(-2.d0*y_unit(k)/3.d0)
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! absorption plus diffusion of +Z
        CASE(8)
          IF (cost(5) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(5)*cost(5)*(d_unit(k)+2.d0*z_unit(k)/3.d0)
            !cmat(j+k)=factor*PAN.area(5)*cost(5)*( 2.d0*z_unit(k)/3.d0)
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! absorption plus diffusion of -Z
        CASE(9)
          IF (cost(6) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(6)*cost(6)*(d_unit(k)-2.d0*z_unit(k)/3.d0)
            !cmat(j+k)=factor*PAN.area(6)*cost(6)*(-2.d0*z_unit(k)/3.d0)
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! reflection coefficient of +X
        CASE(10)
          IF (cost(1) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(1)*cost(1)*2.d0*cost(1)*x_unit(k)
            !cmat(j+k)=factor*PAN.area(1)*cost(1)*( 2.d0*cost(1)*x_unit(k)-d_unit(k))
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! reflection coefficient of -X
        CASE(11)
          IF (cost(2) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(2)*cost(2)*2.d0*cost(2)*(-x_unit(k))
            !cmat(j+k)=factor*PAN.area(2)*cost(2)*(-2.d0*cost(2)*x_unit(k)-d_unit(k))
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! reflection coefficient of +Y
        CASE(12)
          IF (cost(3) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(3)*cost(3)*2.d0*cost(3)*y_unit(k)
            !cmat(j+k)=factor*PAN.area(3)*cost(3)*( 2.d0*cost(3)*y_unit(k)-d_unit(k))
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! reflection coefficient of -Y
        CASE(13)
          IF (cost(4) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(4)*cost(4)*2.d0*cost(4)*(-y_unit(k))
            !cmat(j+k)=factor*PAN.area(4)*cost(4)*(-2.d0*cost(4)*y_unit(k)-d_unit(k))
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! reflection coefficient of +Z
        CASE(14)
          IF (cost(5) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(5)*cost(5)*2.d0*cost(5)*z_unit(k)
            !cmat(j+k)=factor*PAN.area(5)*cost(5)*( 2.d0*cost(5)*z_unit(k)-d_unit(k))
          ELSE
            cmat(j+k)=0.d0
          END IF
        ! reflection coefficient of -Z
        CASE(15)
          IF (cost(6) .GT. 0.d0) THEN
            cmat(j+k)=factor*PAN.area(6)*cost(6)*2.d0*cost(6)*(-z_unit(k))
            !cmat(j+k)=factor*PAN.area(6)*cost(6)*(-2.d0*cost(6)*z_unit(k)-d_unit(k))
          ELSE
            cmat(j+k)=0.d0
          END IF
        CASE(16)
          cmat(j+k)=fac*1.d-3*d0_const*bb_unit(k)*DSIN(u)
        CASE(17)
          cmat(j+k)=fac*1.d-3*d0_const*bb_unit(k)*DCOS(u)
        ! solar radiation pressure scale
        CASE(18)
          cmat(j+k)=f(k)/param(MAXPARLOC)
      END SELECT

    END DO
  END DO

  !!!!!!!!!!!!!! for output
  !  DO i=1, 3
  !    r_unit(i)=xsat(i)
  !    a_unit(i)=xsat(3+i)
  !  END DO

  !  CALL unit_vector(3,r_unit,r_unit,det)
  !  CALL unit_vector(3,a_unit,a_unit,det)
  !  CALL cross(r_unit,a_unit,c_unit)
  !  CALL unit_vector(3,c_unit,c_unit,det)
  !  CALL cross(c_unit,r_unit,a_unit)
  !  CALL unit_vector(3,a_unit,a_unit,det)
  !  f_acr(1)=dot(3,fb,a_unit)
  !  f_acr(2)=dot(3,fb,c_unit)
  !  f_acr(3)=dot(3,fb,r_unit)

  !  f_xyz(1)=dot(3,fb,x_unit)
  !  f_xyz(2)=dot(3,fb,y_unit)
  ! f_xyz(3)=dot(3,fb,z_unit)

  !  CALL cross(d_unit,z_unit,y_unit)
  !  CALL unit_vector(3,y_unit,y_unit,det)
  !  CALL cross(d_unit,y_unit,b_unit)
  !  CALL unit_vector(3,b_unit,b_unit,det)
  ! f_dyb(1)=dot(3,f,d_unit)
  !  f_dyb(2)=dot(3,f,y_unit)
  !  f_dyb(3)=dot(3,f,b_unit)

  !  write(1000,'(f23.12,1X,A3,1X,20E23.12)') mjd+sod/86400.d0,cprn,fb,f_acr,DSQRT(fb(1)**2+fb(2)**2+fb(3)**2),beta*RAD2DEG,(u+PI)*RAD2DEG

  RETURN
  
END SUBROUTINE
