# 1 "/home/xfd/data/PPP/src/exe_fcb/fcb_comp_wide.f90"
! Compute narrow-lane FCBs
! Jianghui Geng
! March 1 2012

SUBROUTINE fcb_comp_wide(CKF,SAT,UPD,NM,PM)
!!
!*
USE info
USE ckdctrl
USE ambiguity
USE satellite
USE ISO_FORTRAN_ENV
IMPLICIT NONE

!*
! Start the exectuable code
!!-----------------------------
TYPE(CKDCFG) :: CKF
TYPE(SATE) :: SAT(MAXSAT)
TYPE(INFM) :: NM(1:*)
TYPE(PRMT) :: PM(CKF.nsys+CKF.nprn+1+2+MAXFREQ*(CKF.nprn+CKF.nprn)+(MAXFREQ-1)*MAXSYS,1:*)
TYPE(FCB) :: UPD

!*
! The local variables
!!-------------------------
  LOGICAL(LG) :: lca(MAXPP),lfirst
  INTEGER(IT) :: i,j,k,isit,isat,jsat,tmp(2),itr
  INTEGER(IT) :: npp,ncd(MAXPP),ifg(MAXSIT*2),iss(2,MAXPP)
  REAL(RL) :: rwl,swl,rlc,alpha,sigm,resi
  REAL(RL) :: val(MAXSAT),sig(MAXSAT),rnl(MAXSIT*2),wgt(MAXSIT*2)
  REAL(RL) :: fnl(MAXPP),vnl(MAXPP),lval(MAXSAT),elev(MAXPP)
  INTEGER(IT) :: isys,nprn(MAXSYS),ipsat,jpsat
  CHARACTER(LEN_PRN) :: cprn(MAXSAT,MAXSYS)

  DATA lfirst /.TRUE./
  DATA val /MAXSAT*10.d0/
  SAVE cprn,lfirst,nprn,val

!*
! The function called
!!----------------------------
  INTEGER(IT) :: pointer_string

!*
! Start the exectuable code
!!----------------------------

  IF (lfirst .EQ. .TRUE.) THEN
    nprn=0
    cprn=''
    DO i=1, CKF.nprn
      IF (TRIM(SAT(i).type).EQ.'BEIDOU-2G' .OR. INDEX(SAT(i).type,'BEIDOU-3G').NE.0) CYCLE
      j=INDEX(CKF.system,CKF.cprn(i)(1:1))
      IF (j .NE. 0) THEN
        nprn(j)=nprn(j)+1
        cprn(nprn(j),j)=CKF.cprn(i)
      END IF
    END DO
    lfirst=.FALSE.
  END IF

  DO isys=1, CKF.nsys

    IF (CKF.system(isys:isys) .EQ. 'R') CYCLE

    lval=10.d0
    DO i=1, nprn(isys)
      k=pointer_string(CKF.nprn,CKF.cprn,cprn(i,isys))
      IF (k .NE. 0) THEN
        lval(i)=val(k)
      END IF
    END DO

!DO itr=1, 3

    lca=.FALSE.
    npp=0
    wgt=1.d0
    iss=0
    DO isat=1, nprn(isys)

      ipsat=pointer_string(CKF.nprn,CKF.cprn,cprn(isat,isys))

      DO jsat=isat+1,nprn(isys)

        jpsat=pointer_string(CKF.nprn,CKF.cprn,cprn(jsat,isys))

        k=0
!! for each site
        DO isit=1, CKF.nsit
!! Bad station
          IF (NM(isit).esig .GT. CKF.DiaSig) CYCLE
          
          DO i=NM(isit).np+1,NM(isit).imtx

            IF (INDEX(PM(i,isit).pname,'AMB') .EQ. 0) CYCLE

            IF (PM(i,isit).elev/PM(i,isit).iobs*RAD2DEG .LT. CKF.cutoff) CYCLE
!!IF (PM(i,isit).elev*RAD2DEG .LT. CKF.cutoff) CYCLE
            IF (PM(i,isit).pcode(2).NE.ipsat .AND. PM(i,isit).pcode(2).NE.jpsat) CYCLE

            DO j=i+1,NM(isit).imtx
              
              IF (INDEX(PM(j,isit).pname,'AMB') .EQ. 0) CYCLE

              IF (PM(j,isit).elev/PM(j,isit).iobs*RAD2DEG .LT. CKF.cutoff) CYCLE
!!IF (PM(j,isit).elev*RAD2DEG .LT. CKF.cutoff) CYCLE
!! form single-difference wide-lane ambiguity
              IF (PM(j,isit).pcode(2).NE.ipsat.AND.PM(j,isit).pcode(2).NE.jpsat .OR. &
                  PM(j,isit).pcode(2).EQ.PM(i,isit).pcode(2)) CYCLE
              IF ((MIN(PM(i,isit).ptime(2),PM(j,isit).ptime(2))-&
                   MAX(PM(i,isit).ptime(1),PM(j,isit).ptime(1)))*86400.d0 .LE. CKF.minsec_common) CYCLE

              IF (PM(i,isit).pcode(2).EQ.ipsat .AND. PM(j,isit).pcode(2).EQ.jpsat) THEN
                rwl=PM(i,isit).abwl-PM(j,isit).abwl
              ELSE
                rwl=PM(j,isit).abwl-PM(i,isit).abwl
              END IF
              swl=DSQRT(PM(i,isit).sigw**2+PM(j,isit).sigw**2)
!rlc=rwl
!IF (UPD.wfcb(ipsat).NE.10.d0 .AND. UPD.wfcb(jpsat).NE.10.d0) THEN
!  rwl=rwl-UPD.wfcb(ipsat)+UPD.wfcb(jpsat)
!END IF
!! attempt to fix this wide-lane ambiguity
!CALL prob_resol(rwl,swl,1,CKF.wl_maxdev,CKF.wl_maxsig,alpha)

!IF (alpha .GT. CKF.wl_alpha) THEN
                k=k+1
                IF (k .GT. MAXSIT*2) THEN
                  WRITE(ERROR_UNIT,'(A)') '***ERROR(fcb_comp_wide): too many ambiguities'
                  CALL exit(1)
                END IF
                rnl(k)=rwl
                wgt(k)=1.d0
                ifg(k)=0
                rnl(k)=rnl(k)-NINT(rnl(k))
                elev(k)=(PM(i,isit).elev+PM(j,isit).elev)/2.d0
!END IF
            END DO
          END DO

        END DO
!! five stations at least
! IF (k .LT. 5) CYCLE
        IF (k .LT. CKF%commonsit) CYCLE

        DO i=1, k-1
          DO j=1, k
            IF (elev(i) .LT. elev(j)) THEN
              resi=elev(i)
              elev(i)=elev(j)
              elev(j)=resi

              resi=rnl(i)
              rnl(i)=rnl(j)
              rnl(j)=resi
            END IF
          END DO
        END DO

!! average collected fractional parts
        npp=npp+1
        iss(1,npp)=isat
        iss(2,npp)=jsat
        lca(isat) =.TRUE.
        lca(jsat) =.TRUE.
        j=0
        fnl(npp)=10.d0
        CALL proc_xl_dirc(k,rnl,wgt,ifg,j,fnl(npp),vnl(npp),sigm)
        ncd(npp)=k-j
!!WRITE(OUTPUT_UNIT,'(2(A3,1X),f8.3,i4,i3,2f8.3)') CKF.cprn(ipsat),CKF.cprn(jpsat),fnl(npp),k,j,vnl(npp),sigm
! xsy-2024-03-30
! IF (ncd(npp) .LT. CKF%commonsit) npp=npp-1
      END DO
    END DO
!IF (npp .EQ. 0) RETURN
    IF (npp .EQ. 0) CYCLE

!! reset spval when necessary
    DO isat=1, nprn(isys)
      i=pointer_string(CKF.nprn,CKF.cprn,cprn(isat,isys))
      IF (lca(isat) .EQ. .FALSE.) THEN
        lval(isat)=10.d0
      END IF
    END DO

!! sort fnl
    DO i=1,npp
      lca(i)=.FALSE.
      DO j=i+1,npp
        IF (ncd(i) .LT. ncd(j)) THEN
          k  =ncd(i); ncd(i)=ncd(j); ncd(j)=k
          sigm=fnl(i); fnl(i)=fnl(j); fnl(j)=sigm
          sigm=vnl(i); vnl(i)=vnl(j); vnl(j)=sigm
          tmp(1:2)=iss(1:2,i);iss(1:2,i)=iss(1:2,j);iss(1:2,j)=tmp(1:2)
        END IF
      END DO
    END DO

!! coarse alignment
    DO WHILE(.TRUE.)
      k=0
      DO i=1,npp
        IF (lca(i)) CYCLE
        isat=iss(1,i)
        jsat=iss(2,i)
        IF (lval(isat).NE.10.d0 .AND. lval(jsat).NE.10.d0) THEN
          k=k+1
          lca(i)=.TRUE.
          fnl(i)=fnl(i)-NINT(fnl(i)-lval(isat)+lval(jsat))
        ELSE IF (lval(isat).NE.10.d0 .AND. lval(jsat).EQ.10.d0) THEN
          k=k+1
          lca(i)=.TRUE.
          lval(jsat)=lval(isat)-fnl(i)
          fnl(i)    =fnl(i)+NINT(lval(jsat))
          lval(jsat)=lval(jsat)-NINT(lval(jsat))
        ELSE IF (lval(isat).EQ.10.d0 .AND. lval(jsat).NE.10.d0) THEN
          k=k+1
          lca(i)=.TRUE.
          lval(isat)=lval(jsat)+fnl(i)
          fnl(i)     =fnl(i)-NINT(lval(isat))
          lval(isat)=lval(isat)-NINT(lval(isat))
        END IF
      END DO
      IF (k .EQ. 0) THEN
        IF (ALL(lca(1:npp) .EQ. .TRUE.)) THEN
          EXIT
        ELSE IF (ALL(lval(1:nprn(isys)) .EQ. 10.d0)) THEN
          lca(1)=.TRUE.
          lval(iss(1,1))=0.d0
          lval(iss(2,1))=-fnl(1)
        ELSE
          WRITE(OUTPUT_UNIT,'(A)') '###WARNING(fcb_comp_wide): over 1 reference '
          j=1
          DO WHILE(j .LE. npp)
            IF (lca(j) .EQ. .FALSE.) THEN
              WRITE(OUTPUT_UNIT,'(A,2(1X,A3))') ' Pair Removed: ',cprn(iss(1,j),isys),cprn(iss(2,j),isys)
              k=j
              DO WHILE(k.LE.npp-1)
                ncd(k)    =ncd(k+1)
                fnl(k)    =fnl(k+1)
                vnl(k)    =vnl(k+1)
                iss(1:2,k)=iss(1:2,k+1)
                lca(k)=lca(k+1)
                k=k+1
              END DO
              npp=npp-1
              CYCLE
            END IF
            j=j+1
          END DO
          EXIT
        END IF
      END IF
    END DO

    CALL alinew(npp,iss,fnl,ncd,vnl,nprn(isys),cprn(1,isys),lval,sig)

!END DO

    DO i=1,nprn(isys)
      j=pointer_string(CKF.nprn,CKF.cprn,cprn(i,isys))
      val(j)=lval(i)
      UPD.wfcb(j)=lval(i)
      UPD.wsl(j)=sig(i)
    END DO

!! output residuals
!WRITE(OUTPUT_UNIT,'(A)') 'WL Residuals after precise alignment:'
    DO i=1,npp
      isat=pointer_string(CKF.nprn,CKF.cprn,cprn(iss(1,i),isys))
      jsat=pointer_string(CKF.nprn,CKF.cprn,cprn(iss(2,i),isys))
      resi=val(isat)-val(jsat)-fnl(i)
      WRITE(2000,'(2(A3,1x),f8.3,i4,f8.3)') cprn(iss(1,i),isys),cprn(iss(2,i),isys),resi,ncd(i),vnl(i)
    END DO

  END DO

  RETURN

END SUBROUTINE

!
!! purpose  : precise alignment of narrow-lane fractional parts based on least squares
!! parameter:
!!    input : npp,iss,fnl,vnl -- satellite-pair FCBs
!!    output: spval -- undifferenced FCB
!!            spsig -- sigma of undifferenced FCB
!! author   : Geng J
!! created  : Aug 18, 2011
!
SUBROUTINE alinew(npp,iss,fnl,ncd,vnl,nprn,cprn,spval,spsig)
!*
USE par
USE const
USE ISO_FORTRAN_ENV
IMPLICIT NONE

!*
! The arguments
!!------------------------
CHARACTER(LEN_PRN) :: cprn(1:*)
INTEGER(IT) :: nprn,npp,iss(2,npp),ncd(npp)
REAL(RL) :: fnl(npp),vnl(npp),spval(1:*),spsig(1:*)

!*
! The local variables
!!-----------------------
  LOGICAL(LG) :: lgd(npp),lest(MAXSAT),lfirst
  INTEGER(IT) :: i,j,isat,jsat,ip,nlarge
  REAL(RL) :: nmat(MAXSAT,MAXSAT),rmat(MAXSAT),corr(MAXSAT),resi(npp)
  REAL(RL) :: ltpl,wgt,tpval,lspval(MAXSAT),gap(3)

!*
! Start the exectuable code
!!----------------------------

!! alignment until residuals getting sufficiently small
  lgd(1:npp)=.TRUE.
  nlarge    =1
  lspval=0.d0
  DO WHILE(nlarge .GT. 0)

    lspval(1:nprn)=spval(1:nprn)

!! form normal matrix and right-hand vector
    nmat=0.d0
    rmat=0.d0
    ltpl=0.d0
    DO i=1,npp
      IF (.NOT.lgd(i)) CYCLE
      isat =iss(1,i)
      jsat =iss(2,i)
      wgt=DBLE(ncd(i)**2) !1.d0
! IF (ncd(i) .LE. 5) CYCLE
      IF (ncd(i) .LE. 5) wgt=DBLE((ncd(i)/4.0)**2)
! wgt=1.d0
! IF (ncd(i) .EQ. 1) wgt=1.d-2
! IF (ncd(i) .GE. 10) THEN
!   wgt=500.d0
! ELSE IF (ncd(i) .GE. 8) THEN
!   wgt=50.d0
! ELSE IF (ncd(i) .GE. 5) THEN
!   wgt=5.d0
! END IF
      tpval=fnl(i)-lspval(isat)+lspval(jsat)
      nmat(isat,isat)=nmat(isat,isat)+wgt
      nmat(jsat,isat)=nmat(jsat,isat)-wgt
      nmat(isat,jsat)=nmat(isat,jsat)-wgt
      nmat(jsat,jsat)=nmat(jsat,jsat)+wgt
      rmat(isat)     =rmat(isat)+tpval*wgt
      rmat(jsat)     =rmat(jsat)-tpval*wgt
      ltpl=ltpl+wgt*tpval**2
    END DO

!! highly weighting unused satellites & reference satellite,
!! if the reference satellite is changed, there will be a jump for UPD
    ip=iss(1,1)
    WRITE(OUTPUT_UNIT,'(A,A3)') 'Reference satellite : ',cprn(ip)
    nmat(ip,ip)=nmat(ip,ip)+1.d10
    lest=.TRUE.
    DO i=1,nprn
      IF (nmat(i,i) .EQ. 0.d0) THEN
        lest(i)=.FALSE.
        nmat(i,i)=1.d10
      END IF
    END DO

!! solve normal equation
    CALL matinv(nmat,MAXSAT,nprn,tpval)
    IF (tpval .EQ. 0.d0) THEN
      WRITE(ERROR_UNIT,'(a)') '***ERROR(alinw): matrix inversion singularity'
      spsig(1:nprn)=9.9d0
      RETURN
!!CALL exit(1)
    END IF
    DO i=1,nprn
      corr(i)=0.d0
      DO j=1,nprn
        corr(i)=corr(i)+nmat(i,j)*rmat(j)
      END DO
      IF (lest(i)) ltpl=ltpl-corr(i)*rmat(i)
    END DO
    DO i=1,nprn
      IF (.NOT.lest(i)) CYCLE
      lspval(i)=lspval(i)+corr(i)
      spsig(i)=DSQRT(nmat(i,i))
    END DO

!! recover residuals
    nlarge=0
    DO i=1,npp
      resi(i)=0.d0
      IF (.NOT.lgd(i)) CYCLE
      isat=iss(1,i)
      jsat=iss(2,i)
      resi(i)=fnl(i)-lspval(isat)+lspval(jsat)
!! detect biases
      IF (DABS(resi(i)) .GT. 0.6d0) THEN
        nlarge=nlarge+1
        fnl(i)=fnl(i)-NINT(resi(i))
        WRITE(OUTPUT_UNIT,'(A,A3,1X,A3,3F8.3,1X,I4)') 'Revert residual, ',cprn(isat),cprn(jsat),fnl(i),resi(i),vnl(i),ncd(i)
      END IF
      IF (DABS(resi(i)) .GT. 0.2d0) THEN
        nlarge=nlarge+1
        lgd(i)=.FALSE.
        WRITE(OUTPUT_UNIT,'(A,A3,1X,A3,2F8.3,1X,I4)') 'Outlier residual, ',cprn(iss(1,i)),cprn(iss(2,i)),resi(i),vnl(i),ncd(i)
        vnl(i)=99.9d0
      END IF
    END DO

!! remove bad sat-pair FCBs
    IF (nlarge .EQ. 0) THEN
      DO i=1,npp
        IF (.NOT.lgd(i)) CYCLE
        IF (DABS(resi(i)) .GT. 0.2d0) THEN
          nlarge=nlarge+1
          lgd(i)=.FALSE.
         WRITE(OUTPUT_UNIT,'(A,A3,1X,A3,2F8.3,1X,I4)') 'Outlier residual, ',cprn(iss(1,i)),cprn(iss(2,i)),resi(i),vnl(i),ncd(i)
        END IF
      END DO
    END IF

!! next least squares
  END DO

!! quality control
  i=COUNT(lest(1:nprn) .EQ. .TRUE.)-1
  j=COUNT(lgd(1:npp) .EQ. .FALSE.)
  IF (npp-j .GT. i) THEN

    tpval=DSQRT(dabs(ltpl)/(npp-j-i))
    DO i=1,nprn
      IF (lest(i) .EQ. .TRUE.) THEN
        spsig(i)=spsig(i)*tpval
        spval(i)=lspval(i)
!IF (lspval(i).GT.1.d0 .OR. lspval(i).LT.-1.d0) THEN
!  gap(1)=lspval(i)-NINT(lspval(i))
!  gap(2)=lspval(i)+1.d0-NINT(lspval(i))
!  gap(3)=lspval(i)-1.d0-NINT(lspval(i))
!  j=MINLOC(dabs(gap),1)
!  spval(i)=gap(j)
!END IF
      END IF
    END DO
  ELSE
    spsig(1:nprn)=9.9d0
  END IF

  RETURN

END SUBROUTINE
