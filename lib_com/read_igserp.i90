# 1 "/home/xfd/data/PPP/src/lib_com/read_igserp.f90"
!*
SUBROUTINE read_igserp(erpfile,jd,sod,tmur,pole)
!!
!! purpose  : read IGS ERP & return TAI-UT1R
!! parameter:
!!    input :
!!            erpfil -- ERP file
!!            jd,sod -- requested time
!!    output: tmur   -- TAI-UT1R
!!            pole   -- pole movement
!! author   : Geng J
!! created  : Oct. 25, 2007
!! modified : May. 13, 2011: leap seconds in terms of igserp table time
!!
!*
USE const
USE ISO_FORTRAN_ENV
IMPLICIT NONE

!*
! The arguments
!!---------------------
INTEGER(IT) :: jd
REAL(RL) :: sod,tmur,pole(2)
CHARACTER(LEN_FILENAME) :: erpfile

!*
! The local variables
!!--------------------------
  LOGICAL(LG) :: lfirst
  INTEGER(IT) :: lfn,i,jd_tdt,ierr
  REAL(RL) :: lp,dut1,sod_tdt,alpha,fjd,mjdx(2),dat(3,2),temp(2)
  CHARACTER(LEN_STRING) :: line

  DATA lfirst /.TRUE./
  SAVE lfirst,lfn,mjdx,dat

!*
! The function called
!!--------------------------
  INTEGER(IT) :: get_valid_unit
  REAL(RL) :: taiutc

!*
! Start the exectuable code
!!-------------------------------

  IF (lfirst) THEN
    lfirst = .FALSE.
    lfn = get_valid_unit(10)
    OPEN(lfn,file=TRIM(erpfile),status='OLD',iostat=ierr)
    IF (ierr .EQ. 0) THEN
      WRITE(OUTPUT_UNIT,'(2A)') '%%%MESSAGE(read_igserp): ERP read ', TRIM(erpfile)
    ELSE
      WRITE(ERROR_UNIT,'(2A)') '***ERROR(read_igserp): open file ', TRIM(erpfile)
      CALL exit(1)
    END IF

    READ(lfn,'(A)') line
    IF (line(1:9).NE.'version 2' .AND. line(1:9).NE.'VERSION 2') THEN
      WRITE(ERROR_UNIT,'(2A)') '***ERROR(read_igserp): unknown version ',line(1:9)
      CALL exit(1)
    END IF

    line=' '
    DO WHILE(INDEX(line,'MJD').EQ.0 .OR. INDEX(line,'UT1').EQ.0 .OR. &
           INDEX(line,'UTC').EQ.0 .OR. INDEX(line,'LOD').EQ.0)
      READ(lfn,'(A)',end=100) line
    END DO
    READ(lfn,'(A)',end=100) line

!! read two records
    mjdx=0
    dat=0.d0
    READ(lfn,'(a)',end=100) line
    READ(line,*,err=200) mjdx(1),(dat(i,1),i=1,3)
    READ(lfn,'(a)',end=100) line
    READ(line,*,err=200) mjdx(2),(dat(i,2),i=1,3)
    DO i=1,2
      fjd=mjdx(i)+OFF_GPS2TT/86400.d0
      CALL RG_ZONT2('IERS2010',(fjd-51544.5)/36525.D0, dut1, temp(1), temp(2))
      dat(3,i)=dat(3,i)*1.d-7-dut1
    END DO
  END IF

!! compare time tag
10 CONTINUE
  IF (jd+sod/86400.d0.GE.mjdx(1) .AND. jd+sod/86400.d0.LE.mjdx(2)) THEN
    alpha=(jd+sod/86400.d0-mjdx(1))/(mjdx(2)-mjdx(1))
    DO i=1,2
      pole(i)=dat(i,1)+alpha*(dat(i,2)-dat(i,1))
      pole(i)=pole(i)*1.d-6
    END DO
    tmur=dat(3,1)+alpha*(dat(3,2)-dat(3,1))
  ELSE IF (jd+sod/86400.d0 .LT. mjdx(1)) THEN
    BACKSPACE(lfn)
    BACKSPACE(lfn)
    BACKSPACE(lfn)
    READ(lfn,'(A)',END=100) line
    READ(line,*,ERR=200) mjdx(1),(dat(i,1),i=1,3)
    READ(lfn,'(A)',END=100) line
    READ(line,*,ERR=200) mjdx(2),(dat(i,2),i=1,3)
    DO i=1,2
      fjd=mjdx(i)+OFF_GPS2TT/86400.d0
      CALL RG_ZONT2('IERS2010',(fjd-51544.5)/36525.D0, dut1, temp(1), temp(2))
      dat(3,i)=dat(3,i)*1.d-7-dut1
    END DO
    GOTO 10
  ELSE IF (jd+sod/86400.d0 .GT. mjdx(2)) THEN
    mjdx(1)=mjdx(2)
    DO i=1,3
      dat(i,1)=dat(i,2)
    END DO
    READ(lfn,'(A)',END=100) line
    READ(line,*,ERR=200) mjdx(2),(dat(i,2),i=1,3)
    fjd=mjdx(2)+OFF_GPS2TT/86400.d0
    CALL RG_ZONT2('IERS2010',(fjd-51544.5)/36525.D0, dut1, temp(1), temp(2))
    dat(3,2)=dat(3,2)*1.d-7-dut1
    GOTO 10
  END IF

  RETURN

100 WRITE(ERROR_UNIT,'(A)') '***ERROR(read_igserp): end of file igserp'
  CALL exit(1)
200 WRITE(ERROR_UNIT,'(2A)') '***ERROR(read_igserp): read file igserp ', TRIM(line)
  CALL exit(1)


ENTRY igserp_reset()

  lfirst=.TRUE.
  CLOSE(lfn)

  RETURN

END SUBROUTINE
