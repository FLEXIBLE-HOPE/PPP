# 1 "/home/xfd/data/PPP/src/lib_modules/mod_par.f90"
!*
MODULE par
!!
!*
IMPLICIT NONE

  INTEGER*4, PARAMETER :: IT = SELECTED_INT_KIND(6)
  INTEGER*4, PARAMETER :: RL = SELECTED_REAL_KIND(8,70)
  INTEGER*4, PARAMETER :: LG = 4

  INTEGER(IT), PARAMETER :: MAXSAT = 160
  INTEGER(IT), PARAMETER :: MAXSIT = 160
!! 2023-10-12 by xsy: MAX receiver types
  INTEGER(IT), PARAMETER :: MAXRECTYPE = 50
  
  INTEGER(IT), PARAMETER :: MAXEPH = MAXSAT*24 ! MAXSAT*24*5
  INTEGER(IT), PARAMETER :: MAXEPO = 86401 ! 86400

  INTEGER(IT), PARAMETER :: MAXOBSTYP = 50
  INTEGER(IT), PARAMETER :: MAXSYS = 8
  INTEGER(IT), PARAMETER :: MAXFREQ = 5 !3

! 0.01D0 used for most of data
! 0.05D0 used for SWARM only
  REAL(RL), PARAMETER :: MAXWND = 0.05D0

! the PCV angle
  INTEGER(IT), PARAMETER :: MAXPCVDEG = 17
! evereet interpolation: degree and number of points
  INTEGER(IT), PARAMETER :: MAXDGR = 7
  INTEGER(IT), PARAMETER :: MAXPNT = 2*(MAXDGR+1)

! sections of predicted orbits
  INTEGER(IT), PARAMETER :: MAXORB = 12

! For orbit
! force model
  INTEGER(IT), PARAMETER :: MAXFORCE = 13
! all dynamic parameters
  INTEGER(IT), PARAMETER :: MAXORBPAR = 64
! planets
  INTEGER(IT), PARAMETER :: MAXPLANET = 12
! all orbit parameters including:
! orbital elements (satellite-dependent): 3+3
! dynamic parameters (satellite-dependent): MAXDYNPAR
! gravity field model :: MAXGRVPAR (lmax+1)**2-lmin**2
  INTEGER(IT), PARAMETER :: MAXGRAPAR = 12*2
  INTEGER(IT), PARAMETER :: MAXDYNPAR = 12
  INTEGER(IT), PARAMETER :: MAXICS = 6+MAXDYNPAR+MAXGRAPAR
  INTEGER(IT), PARAMETER :: MAXVARS = 3*(MAXICS+1)
  INTEGER(IT), PARAMETER :: MAXEQUS = 6*(MAXICS+1)
! the number of pieces is no more then 21
  INTEGER(IT), PARAMETER :: MAXPWC = 6+MAXDYNPAR+24
  INTEGER(IT), PARAMETER :: MAXPWCEQUS = 6*(MAXPWC+1)
! Max gravity degree
  INTEGER(IT), PARAMETER :: MAXGRADEG = 150
! Max ocean tide degree FES2004: 80; EOT11a:120; FES2014b:180
  INTEGER(IT), PARAMETER :: MAXOCNDEG = 120
! Max ocean pole tide
  INTEGER(IT), PARAMETER :: MAXOPTDEG = 80
! Max GRACE atmosphere, ocean, and de-alising
  INTEGER(IT), PARAMETER :: MAXAODDEG = 100
  INTEGER(IT), PARAMETER :: MAXPANS = 20

! Ambiguities and UPDs
  INTEGER(IT), PARAMETER :: MAXAMBSIT = MAXSAT*10
  INTEGER(IT), PARAMETER :: MAXAMBNET = MAXAMBSIT*MAXSIT
! satellite-difference ambiguities
  INTEGER(IT), PARAMETER :: MAXPP = MAXSAT*(MAXSAT-1)/2
  
! Ionosphere TECU
  INTEGER(IT), PARAMETER :: MAXIONMAPS = 25
  INTEGER(IT), PARAMETER :: MAXIONLAT = 71
  INTEGER(IT), PARAMETER :: MAXIONLON = 73
  INTEGER(IT), PARAMETER :: MAXIONHGT = 1

! receiver dependent parameters:
! coordinates (site-dependent): 3
! clock and ISB (site-/frequency-dependent): MAXSYS
! ifb (site-/frequency-depdent): MAXSAT (omit)
! ztd (site-depdent): 1
! ion (sit-satellite-dependent): MAXSAT (omit)
! pco (sit-dependent): 3
! pcv (site-frequency-dependent): ?? (omit)
! ambiguities (site-satellite-depdendent): MAXAMBSIT
! satellite depdendent parameters:
! pco (sit-dependent): 3
! pcv (site-frequency-dependent): MAXPCVDEG (omit)
! clock: 1
! orbit parameters: 6+MAXDYNPAR
! gravity parameters: MAXGRAPAR
  INTEGER(IT), PARAMETER :: MAXPARSIT=3+MAXSYS+1+3+MAXSAT*(3+1+6+MAXDYNPAR)+MAXAMBSIT+MAXGRAPAR
  INTEGER(IT), PARAMETER :: MAXPARNET=MAXSIT*(3+MAXSYS+1+3)+MAXSAT*(3+1+6+MAXDYNPAR)+MAXAMBNET+MAXGRAPAR

  INTEGER(IT), PARAMETER :: LEN_PRN = 3
  INTEGER(IT), PARAMETER :: LEN_FREQ = 3
  INTEGER(IT), PARAMETER :: LEN_SITENAME = 4
  INTEGER(IT), PARAMETER :: LEN_SITETYPE = 2
  INTEGER(IT), PARAMETER :: LEN_COSPARID = 7
  INTEGER(IT), PARAMETER :: LEN_ANTENNA = 20
  INTEGER(IT), PARAMETER :: LEN_SATTYPE = 20
  INTEGER(IT), PARAMETER :: LEN_PCVTYPE = 5
  INTEGER(IT), PARAMETER :: LEN_CLKTYPE = 5
  INTEGER(IT), PARAMETER :: LEN_ZTDMAP = 3
  INTEGER(IT), PARAMETER :: LEN_OBSTYPE = 3
  INTEGER(IT), PARAMETER :: LEN_PARNAME = 20
  INTEGER(IT), PARAMETER :: LEN_PORT = 10
  INTEGER(IT), PARAMETER :: LEN_ZTDMOD = 20
  INTEGER(IT), PARAMETER :: LEN_IONMOD = 20
  INTEGER(IT), PARAMETER :: LEN_FILENAME = 1024
  INTEGER(IT), PARAMETER :: LEN_STRING = 1024
  INTEGER(IT), PARAMETER :: LEN_FILENAME_SYB = 10
  INTEGER(IT), PARAMETER :: LEN_EPHION = 4
  INTEGER(IT), PARAMETER :: LEN_FORCE = 20
  INTEGER(IT), PARAMETER :: LEN_ORBPAR = 10
  INTEGER(IT), PARAMETER :: LEN_RUNTIM = 25

! Global variable for SINEX CODE
  CHARACTER(LEN=10) :: ATXWEEK = 'IGS14_1796'
  COMMON /ATXW/ ATXWEEK

! SDB cluster groups
  INTEGER(IT), PARAMETER :: MAXCLUSTER = 30

END MODULE
