! For lsq
    CHARACTER(LEN_FILENAME) :: flnpar = ''
    CHARACTER(LEN_FILENAME) :: flnnom = ''
!!xsy-22-9-17:osb
    CHARACTER(LEN_FILENAME) :: flnosb = ''
